---
import Base from '../layouts/Base.astro';
import SignupBand from '../components/SignupBand.astro';

// שאלות שחוזרות מארגונים לפני שמזמינים. התשובות כאן חופפות למה שכתוב בשאר האתר — לא מבטיחות יותר.
const faq = [
  {
    q: 'המידע שלנו בטוח בסדנה?',
    a: 'בסדנה כל משתתף עובד בחשבון שלו, על מסמכים שהוא בחר להביא. אנחנו לא מקבלים את החומרים שלכם, לא שומרים אותם ולא מעלים אותם לשום מקום. לפני הסדנה אנחנו אומרים מה מתאים להביא ומה לא, לפי אותו כלל שמלמדים במסלול: מה אסור להכניס.',
    link: { href: '/maslul/ma-asur-lehachnis', text: 'השיעור על מה אסור להכניס' },
  },
  {
    q: 'אנחנו לא ארגון טכנולוגי. זה בכלל בשבילנו?',
    a: 'זה בדיוק למי שהאתר הזה נבנה. רוב הזמן בסדנה הוא עבודה על החומרים שלכם, לא על הכלי. ומי שבטוח שזה לא בשבילו הוא בדיוק מי שאנחנו טובים איתו. עשרים שנה בכיתה זה בעיקר זה.',
  },
  {
    q: 'מה צריך להכין לפני?',
    a: 'עדיף מחשב נייד לכל משתתף, ולפחות טלפון חכם, כי חלק מהתרגילים עובדים גם ממנו. בנוסף חשבון חינמי באחד הכלים, ומסמך אחד או שניים מהעבודה האמיתית. אנחנו שולחים מראש מה בדיוק להביא, כדי שאף אחד לא יגיע עם משהו שאסור לו להעלות.',
  },
  {
    q: 'מה ההבדל ביניכם למרצה טכנולוגי?',
    a: 'היחס האישי. רוב הזמן בסדנה כל משתתף עובד על משימה מהעבודה שלו, ואנחנו עוברים ביניהם, יושבים ליד מי שנתקע ועוזרים לו להתקדם עם מה שהוא הביא. זו חניכה אישית בתוך הסדנה, ולכן אנחנו באים שניים: כך אפשר להגיע לכל משתתף, גם למי שלא ירים יד. זה מגיע מהרקע שלנו. שנינו מנחים כבר למעלה מ־20 שנה, ולא טכנולוגים שלמדו להרצות.',
  },
  {
    q: 'אתם מוכרים כלי מסוים?',
    a: 'לא. אנחנו מוכרים שירות: הכשרה, הקניית ידע וליווי בהטמעה. אנחנו לא מקבלים עמלה מאף ספק, ובמדריך הכלים כתוב גם למי כל כלי לא מתאים. ממליצים לפי המשימה, לא לפי המותג.',
    link: { href: '/kelim', text: 'מדריך הכלים' },
  },
  {
    q: 'מה קורה אחרי ההרצאה?',
    a: 'ההרצאה היא ההתחלה: כולם רואים מה אפשר, ויוצאים עם חשק לנסות. מי שרוצה להמשיך לבד, המסלול פתוח בחינם. מי שרוצה שזה יהפוך להרגל בכל הצוות, יש סדנאות וליווי. ואם נראה לנו שהרצאה מספיקה לכם כרגע, נגיד גם את זה.',
    link: { href: '/maslul', text: 'המסלול, בחינם' },
  },
  {
    q: 'כמה זה עולה?',
    a: "תלוי בתוכנית, בגודל הקבוצה ובהיקף. בעמוד התוכניות כתוב במה כל תוכנית נוגעת, וכותבים לנו כדי לקבל הצעה.",
    link: { href: '/irgunim', text: 'התוכניות לארגונים' },
  },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---
<Base
  title="מי אנחנו · Nexadapt"
  description="ארן נחמיאס ומתי מצוינים. שני מנחים בעלי ותק של למעלה מ־20 שנה בניהול, תפעול והטמעת טכנולוגיה בארגונים, ועכשיו עושים את זה עם AI."
>
  <section class="wrap head">
    <h1 class="head__title">שני מנחים ותיקים שמכירים ארגונים מבפנים.</h1>
    <p class="head__sub">
      שנינו בעלי ותק של למעלה מ־20 שנה בניהול, תפעול והטמעת טכנולוגיה בארגונים, וכבר עשינו את המעבר
      הזה פעם אחת עם טכנולוגיות אחרות. עכשיו אנחנו עושים אותו עם AI.
    </p>
  </section>

  <section class="wrap story band-story" aria-labelledby="story-t">
    <div class="story__grid">
      <div class="story__text">
        <p class="story__kicker">סיפור מהשטח · הקורונה, 2020</p>
        <h2 id="story-t" class="story__q">
          במרץ 2020 ארן ניהל את הלמידה וההדרכה בפעמונים, והיה צריך להעביר 3,000 מתנדבים,
          שכל העבודה שלהם עד אז הייתה פנים אל פנים, לעבודה מרחוק בזום. תוך 30 יום.
        </h2>
        <p class="story__note">
          זה בדיוק מה שארגונים עוברים היום מול AI: אנשים שלא ביקשו את השינוי, שיטת עבודה שמשתנה
          בבת אחת, ולוח זמנים שלא מחכה לאף אחד.
        </p>
        <p class="story__more"><a href="/maslul/shloshet-alafim-be-30-yom">הסיפור המלא, ומה אפשר ללמוד ממנו <i aria-hidden="true">←</i></a></p>
      </div>
      <div class="story__stat">
        <p class="story__num" data-count="88" data-suffix="%">88%</p>
        <p class="story__numLabel">מהמתנדבים עברו לזום</p>
        <p class="story__sub">תוך 30 יום. ושביעות רצון המשפחות עלתה, מ־90% ל־94%</p>
      </div>
    </div>
  </section>

  <section class="wrap people">
    <article class="p">
      <img class="p__photo" src="/anachnu/aran.webp" alt="ארן נחמיאס" width="480" height="480" loading="lazy" decoding="async" />
      <h2 class="p__name">ארן נחמיאס</h2>
      <p class="p__role">מנהל מוצר ותפעול · למידה והדרכה בארגונים</p>
      <p class="p__line">
        "אני מלמד מ־2003, ובעשור האחרון בעיקר מול עובדים ומנהלים בתוך ארגונים — הרצאות, הכשרות,
        הטמעות. במקביל ניהלתי תפעול, מוצר ולמידה. את החדר של ארבעים איש שלא ביקשו להיות שם אני
        מכיר משני הצדדים: של מי שמעביר, ושל מי שצריך אחר כך שזה יעבוד ביום שני בבוקר. ומה שראיתי
        משם חוזר על עצמו: כמעט שום הטמעה לא נכשלת בגלל הכלי. היא נכשלת כי לא בדקו מה באמת קורה
        בעבודה של האנשים לפני שהחליטו מה ללמד אותם. לכן רוב הזמן אצלנו הוא לא הסבר על כלי, אלא
        עבודה על החומרים שהמשתתפים מביאים מהשולחן שלהם."
      </p>
      <ul class="p__facts">
        <li>העברתי הרצאות והדרכות בארגונים, מצוותים קטנים ועד מליאות של מאות איש</li>
        <li>הקמתי וניהלתי בית ספר פסיכומטרי ארצי לבעלי לקויות למידה והפרעת קשב וריכוז</li>
        <li>ניהלתי תקציב הדרכה שנתי והכשרה של 3,000+ עובדים ומתנדבים</li>
        <li>גייסתי 1.5 מיליון דולר להקמת מערכת למידה ארגונית, ובניתי אותה</li>
        <li>ניהלתי פדגוגית 30 מרכזים וכ־9,000 תלמידים בתוכנית למחוננים</li>
        <li>בניתי מחדש את גיוס המורים: גידול של 120% במאגר, והנשירה ירדה מ־32% ל־12%</li>
        <li>במילואים אני סמג״ד ומפקד קורס קצינים</li>
      </ul>
    </article>

    <article class="p">
      <img class="p__photo" src="/anachnu/mati.webp" alt="מתי מצוינים" width="480" height="480" loading="lazy" decoding="async" />
      <h2 class="p__name">מתי מצוינים</h2>
      <p class="p__role">טכנולוג ראשי בתעשייה לשעבר · M.Sc. ביוטכנולוגיה</p>
      <p class="p__line">
        "התחלתי להדריך בצבא, כקצין לוגיסטיקה צעיר שהיה צריך לרתום ולמקצע חיילים חסרי מוטיבציה
        ומרקעים לא פשוטים. במקביל ללימודי התארים הראשון והשני הדרכתי אוכלוסיות מגוונות, מילדי
        יסודי וחטיבה ועד סטודנטים מכל המגזרים, כולל עולים חדשים ולקויי למידה. אחר כך עבדתי חמש
        שנים במו״פ של סטארטאפ בתחום ההנדסה הגנטית ושמונה שנים כטכנולוג ראשי בתעשייה, כשבאמצע
        הספקתי להיות גם מורה בחטיבה ובתיכון. שני הדברים המשמעותיים שלמדתי בדרך: הקושי כמעט אף
        פעם לא נובע מאי־יכולת אלא מהפחד מהלא־מוכר, והדרך לפרק אותו היא לא להפסיק להאמין ביכולת
        של מי שאתה מלמד. והשני — כדי להצליח, התאמה לקהל היעד היא הכרחית."
      </p>
      <ul class="p__facts">
        <li>שמונה שנים הייתי טכנולוג ראשי: הטמעתי טכנולוגיות ייצור, ניהלתי אישורי חומרים וישבתי בפורום עיצוב ברמת הנהלה</li>
        <li>תרגלתי במכללה במעבדות מיקרוביולוגיה וגנטיקה מולקולרית</li>
        <li>חנכתי סטודנטים, עולים חדשים ולקויי למידה</li>
        <li>לימדתי מדעים בתיכון והנחיתי עבודות גמר</li>
        <li>הייתי חוקר מו״פ בסטארטאפ להנדסה גנטית, וזכיין של <span dir="ltr">e² Young Engineers</span></li>
        <li>במילואים אני רס״ן, מפקד בקורס קצינים וקצין לוגיסטיקה</li>
      </ul>
    </article>
  </section>

  <section class="wrap why">
    <h2 class="why__t">למה זה משנה למי שמזמין</h2>
    <p>
      רוב מרצי ה־AI בישראל הם טכנולוגים שלמדו להרצות. אצלנו זה בכיוון ההפוך, ובחדר זה מרגיש אחרת:
      בכל קבוצה יש שניים־שלושה שנשארים מאחור ולא אומרים את זה בקול. עשרים שנות הוראה זה בעיקר
      היכולת לזהות אותם ולא לאבד אותם.
    </p>
    <p>
      וזו גם הסיבה שאנחנו מגיעים שניים. כך אפשר לפצל את החדר לשתי קבוצות עבודה, גם כשהקבוצה לא גדולה,
      ולהגיע לכל משתתף, גם כשכל אחד עובד על משהו אחר מהעבודה שלו.
    </p>
  </section>

  <section class="wrap faq" aria-labelledby="faq-t">
    <h2 id="faq-t" class="faq__t">שאלות ששואלים אותנו לפני שמזמינים</h2>
    <div class="faq__list">
      {faq.map((f) => (
        <details class="faq__item">
          <summary class="faq__q">{f.q}</summary>
          <div class="faq__a">
            <p>{f.a}</p>
            {f.link && <p class="faq__link"><a href={f.link.href}>{f.link.text} <i aria-hidden="true">←</i></a></p>}
          </div>
        </details>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={faqLd} />

  <SignupBand />
</Base>

<style>
  .head { padding-block: 3rem 1.5rem; }
  .head__title { font-size: clamp(2.1rem, 4.6vw, 3rem); max-inline-size: 20ch; margin-block-end: 1rem; }
  .head__sub { font-size: var(--t-xl); color: var(--ink-muted); font-weight: 300; max-inline-size: 58ch; }

  .band-story {
    background: var(--deep); color: var(--ink-on-deep);
    border-radius: var(--r-card);
    padding: 2.25rem 2.4rem;
    background-image: radial-gradient(600px 300px at 90% -20%, rgba(198,214,63,0.15), transparent 62%);
    margin-block-end: 3rem;
    max-inline-size: none;
  }
  .story__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.85fr); gap: clamp(1.75rem, 4vw, 3.25rem); align-items: center; }
  .story__kicker { color: var(--accent); font-size: var(--t-sm); font-weight: 500; margin: 0 0 0.6rem; }
  .story__q { font-size: var(--t-xl); line-height: 1.55; color: var(--ink-on-deep); font-family: var(--font-body); font-weight: 400; max-inline-size: 44ch; margin-block: 0 1rem; }
  .story__note { color: var(--ink-on-deep-mute); font-weight: 300; max-inline-size: 50ch; margin: 0; font-size: var(--t-sm); text-wrap: pretty; }
  .story__more { margin: 0.9rem 0 0; font-size: var(--t-sm); }
  .story__more a { color: var(--ink-on-deep); text-decoration: none; border-block-end: 1px solid var(--accent); padding-block-end: 1px; }
  .story__more a:hover { color: var(--accent); }
  .story__more a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
  .story__stat { border-inline-start: 2px solid var(--accent); padding-inline-start: clamp(1.25rem, 2.5vw, 2rem); }
  .story__num { font-family: var(--font-display); font-size: clamp(3.4rem, 7.5vw, 5.25rem); line-height: 0.95; color: var(--accent); margin: 0 0 0.4rem; }
  .story__numLabel { font-family: var(--font-display); font-size: var(--t-2xl); color: var(--ink-on-deep); margin: 0 0 0.7rem; }
  .story__sub { color: var(--ink-on-deep-mute); font-weight: 300; font-size: var(--t-sm); margin: 0; max-inline-size: 28ch; }
  @media (max-width: 900px) {
    .story__grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .story__stat { border-inline-start: 0; border-block-start: 2px solid var(--accent); padding-inline-start: 0; padding-block-start: 1.25rem; }
  }

  .people { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; padding-block-end: 3rem; }
  .p__photo { inline-size: 132px; block-size: 132px; border-radius: var(--r-card); object-fit: cover; box-shadow: var(--shadow-2); margin-block-end: 1.1rem; display: block; }
  .p__name { font-size: var(--t-2xl); margin-block-end: 0.25rem; }
  .p__role { font-size: var(--t-sm); color: var(--ink-faint); margin-block-end: 1.1rem; }
  .p__line { color: var(--ink); font-size: var(--t-lg); line-height: 1.75; border-inline-start: 3px solid var(--accent); padding-inline-start: 1.1rem; margin-block-end: 1.3rem; }
  .p__facts { margin: 0; padding-inline-start: 1.2rem; font-size: var(--t-sm); color: var(--ink-muted); font-weight: 300; }
  .p__facts li { margin-block-end: 0.5rem; }
  .p__facts li::marker { color: var(--accent-deep); }
  @media (max-width: 860px) { .people { grid-template-columns: 1fr; gap: 2rem; } }

  .why { padding-block: 2.5rem 4rem; border-block-start: 1px solid var(--rule); }
  .why__t { font-size: var(--t-2xl); margin-block-end: 1rem; }
  .why p { color: var(--ink-muted); font-weight: 300; max-inline-size: 62ch; font-size: var(--t-lg); }

  .faq { padding-block: 2.5rem 4rem; border-block-start: 1px solid var(--rule); }
  .faq__t { font-size: var(--t-2xl); margin-block-end: 1.25rem; max-inline-size: 30ch; }
  .faq__list { display: grid; gap: 0.6rem; max-inline-size: 72ch; }
  .faq__item {
    background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r-card);
    box-shadow: var(--shadow-1);
  }
  .faq__item[open] { border-color: var(--rule-strong); }
  .faq__q {
    cursor: pointer; list-style: none; padding: 1rem 1.25rem;
    font-weight: 600; color: var(--ink-strong); font-size: var(--t-base);
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after {
    content: '+'; font-family: var(--font-display); color: var(--accent-deep);
    font-size: var(--t-xl); line-height: 1; flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .faq__item[open] .faq__q::after { transform: rotate(45deg); }
  .faq__q:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: var(--r-card); }
  .faq__a { padding: 0 1.25rem 1.1rem; }
  .faq__a p { margin: 0; color: var(--ink-muted); font-weight: 300; line-height: var(--lh-normal); font-size: var(--t-base); }
  .faq__link { margin-block-start: 0.6rem !important; font-size: var(--t-sm) !important; }
  .faq__link a { color: var(--ink); text-decoration: none; border-block-end: 1px solid var(--accent); }
  .faq__link a:hover { color: var(--ink-strong); }
</style>
