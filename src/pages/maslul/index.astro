---
import Base from '../../layouts/Base.astro';
import SignupBand from '../../components/SignupBand.astro';
import { getCollection } from 'astro:content';
import TrackNav from '../../components/TrackNav.astro';
import { STAGES, TOTAL_LESSONS } from '../../data/track';

// שכבה שנייה ושלישית של המסלול: הכלים וההדגמות שמשויכים לכל שלב
const tools = (await getCollection('kelim', (e) => e.data.published && e.data.stages.length > 0))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const demos = (await getCollection('efshar', (e) => e.data.published && e.data.stage !== undefined))
  .sort((a, b) => a.data.order - b.data.order);
const toolsFor = (n: number) => tools.filter((t) => t.data.stages.includes(n));
const demosFor = (n: number) => demos.filter((d) => d.data.stage === n);
const toolCount = tools.length;

const live = await getCollection('maslul', (e) => e.data.published);
const liveSlugs = new Set(live.map((e) => e.id));
const liveCount = live.length;
const lastLiveIndex = (items: { slug: string }[]) => items.reduce((m, it, i) => (liveSlugs.has(it.slug) ? i : m), -1);
---
<Base
  title="המסלול · קפיצת מדרגה"
  description={`${TOTAL_LESSONS} שיעורים על AI בארגונים, מהאפס עד הטמעה. פתוח לכולם, בחינם, שיעור חדש בכל שבוע.`}
>
  <section class="wrap head head--photo">
    <div class="head__text">
    <h1 class="head__title">המסלול</h1>
    <p class="head__sub">
      {TOTAL_LESSONS} שיעורים בחמישה שלבים, מ"מה זה בכלל" עד תוכנית הטמעה שאפשר להביא להנהלה.
      הכל פתוח, בלי תשלום ובלי הרשמה.
    </p>
    <p class="head__count">
      <strong>{liveCount}</strong> שיעורים באוויר · שיעור חדש בכל שבוע · השאר כבר כתובים בתוכנית ומופיעים למטה
    </p>
    <p class="head__layers">שלוש שכבות של אותה למידה: <strong>{TOTAL_LESSONS} שיעורים</strong>, <strong>{toolCount} כלים</strong> שנכנסים בדיוק בשלב שצריך אותם, ו<strong>הדגמות חיות</strong> של מה שנהיה אפשרי.</p>
    </div>
    <div class="head__media rise">
      <img src="/photos/maslul.webp" width="1200" height="800" alt="עובדת לומדת לבד מול מחשב נייד במשרד שקט, עם מחברת וכוס קפה" fetchpriority="high" decoding="async" />
    </div>
  </section>

  <TrackNav />

  {STAGES.map((s) => (

    <section class="wrap stage" aria-labelledby={`stage-${s.n}`}>
      <div class="stage__head">
        <div class="stage__n" aria-hidden="true">{s.n}</div>
        <div>
          <h2 id={`stage-${s.n}`} class="stage__title">{s.title}</h2>
          <p class="stage__q">{s.question}</p>
          <p class="stage__out"><span>בסוף השלב</span> {s.outcome}</p>
        </div>
      </div>
      <ol class="stage__list tl" data-stagger="70" style={`--fill:${lastLiveIndex(s.items) < 0 ? 0 : ((lastLiveIndex(s.items) + 0.5) / s.items.length) * 100}%`}>
        <span class="tl__line" aria-hidden="true"><i></i></span>
        {s.items.map((it) => {
          const isLive = liveSlugs.has(it.slug);
          return (
            <li class:list={['it', 'reveal', 'reveal--x', { 'it--live': isLive, 'it--soon': !isLive }]}>
              {isLive ? (
                <a href={`/maslul/${it.slug}`} class="it__inner">
                  <span class="it__n" transition:name={`lesson-n-${it.slug}`}>{it.n}</span>
                  <span class="it__body">
                    <span class="it__t">{it.title}</span>
                    <span class="it__note">{it.note}</span>
                  </span>
                  <span class="it__state">{it.interactive ? 'אינטראקטיבי' : 'קראו'} <span class="it__arrow" aria-hidden="true">←</span></span>
                </a>
              ) : (
                <div class="it__inner">
                  <span class="it__n">{it.n}</span>
                  <span class="it__body">
                    <span class="it__t">{it.title}</span>
                    <span class="it__note">{it.note}</span>
                  </span>
                  <span class="it__state it__state--soon">בקרוב</span>
                </div>
              )}
            </li>
          );
        })}
      </ol>

      {(toolsFor(s.n).length > 0 || demosFor(s.n).length > 0) && (
        <div class="layers reveal">
          {toolsFor(s.n).length > 0 && (
            <div class="layers__tools">
              <p class="layers__label">הכלים לשלב הזה</p>
              <ul class="layers__list">
                {toolsFor(s.n).map((t) => (
                  <li>
                    <a href={`/kelim/${t.id}`} class:list={['chip', { 'chip--featured': t.data.featured }]}>
                      <img src={`/kelim-logos/${t.id}.svg`} alt="" width="22" height="22" loading="lazy" />
                      <span>{t.data.name}</span>
                      {t.data.featured && <em>מתחילים כאן</em>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {demosFor(s.n).length > 0 && (
            <div class="layers__demos">
              {demosFor(s.n).map((d) => (
                <a href={`/efshar/${d.id}`} class="layers__demo">
                  <span class="layers__demoLabel">מה כבר אפשר בשלב הזה</span>
                  <strong>{d.data.title}</strong>
                  <span class="layers__demoAfter">{d.data.after}</span>
                  <span class="layers__demoMeta">נבנה ב{d.data.built} <i aria-hidden="true">←</i></span>
                </a>
              ))}
            </div>
          )}
        </div>
      )}
    </section>
  ))}

  <SignupBand />
</Base>

<style>
  .head { padding-block: 3rem 2rem; }
  .head__layers { font-size: var(--t-base); color: var(--ink-muted); max-inline-size: 56ch; margin-block: 0.9rem 0; }
  .head__layers strong { color: var(--ink-strong); font-weight: 600; }

  /* שכבות הכלים וההדגמות של כל שלב */
  .layers { display: grid; gap: 1rem; margin-block: 1.4rem 0.5rem; padding-inline-start: 2.6rem; }
  .layers__demos { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
  .layers__tools, .layers__demo {
    background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r-card); padding: 1.1rem 1.25rem;
  }
  .layers__label, .layers__demoLabel { display: block; font-size: var(--t-xs); color: var(--ink-faint); margin-block-end: 0.6rem; }
  .layers__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.8rem 0.45rem 0.6rem;
    border: 1px solid var(--rule); border-radius: 999px; background: var(--surface-sunk); text-decoration: none; color: var(--ink);
    font-size: var(--t-sm); font-weight: 500; transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .chip:hover { transform: translateY(-2px); border-color: var(--rule-strong); }
  .chip img { inline-size: 22px; block-size: 22px; border-radius: 4px; }
  .chip--featured { border-color: var(--accent); background: var(--accent-soft); }
  .chip em { font-style: normal; font-size: var(--t-xs); color: var(--accent-deep); font-weight: 600; }
  .layers__demo { display: flex; flex-direction: column; gap: 0.3rem; text-decoration: none; color: var(--ink);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .layers__demo:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .layers__demo strong { font-family: var(--font-display); font-weight: 400; font-size: var(--t-lg); color: var(--ink-strong); }
  .layers__demoAfter { font-size: var(--t-sm); color: var(--ink-muted); line-height: 1.55; }
  .layers__demoMeta { font-size: var(--t-xs); color: var(--accent-deep); font-weight: 600; margin-block-start: 0.3rem; }
  .layers__demoMeta i { font-style: normal; display: inline-block; transition: transform var(--dur-fast) var(--ease-out); }
  .layers__demo:hover .layers__demoMeta i { transform: translateX(-4px); }
  @media (max-width: 640px) { .layers { padding-inline-start: 1.9rem; } }
  .head__title { font-size: clamp(2.4rem, 5vw, 3.4rem); margin-block-end: 0.9rem; }
  .head__sub { font-size: var(--t-xl); color: var(--ink-muted); font-weight: 300; max-inline-size: 56ch; margin-block-end: 1.2rem; }
  .head__count { font-size: var(--t-sm); color: var(--ink-muted); margin: 0; }
  .head__count strong { color: var(--ink-strong); font-family: var(--font-display); font-size: var(--t-lg); }

  .stage { padding-block: 2.25rem; border-block-start: 1px solid var(--rule); }
  .stage__head { display: grid; grid-template-columns: auto 1fr; gap: 1.4rem; margin-block-end: 1.5rem; align-items: start; }
  .stage__n {
    font-family: var(--font-display); font-size: 1.5rem; color: var(--accent-ink);
    background: var(--accent); inline-size: 2.9rem; block-size: 2.9rem;
    border-radius: var(--r-control); display: grid; place-items: center; margin-block-start: 0.2rem;
  }
  .stage__title { font-size: var(--t-2xl); margin-block-end: 0.35rem; }
  .stage__q { color: var(--ink-faint); font-style: italic; margin-block-end: 0.5rem; font-size: var(--t-sm); }
  .stage__out { font-size: var(--t-sm); color: var(--ink-muted); margin: 0; }
  .stage__out span { color: var(--accent-deep); font-weight: 500; }

  .stage__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; position: relative; }
  /* the timeline: a faint rail, and a citron line that fills to the last published lesson */
  .tl { padding-inline-start: 2.6rem; }
  .tl__line { position: absolute; inset-block: 1.4rem; inset-inline-start: 0.95rem; inline-size: 2px; background: var(--rule); border-radius: 2px; overflow: hidden; }
  .tl__line i { display: block; inline-size: 100%; block-size: var(--fill); background: var(--accent); transform: scaleY(0); transform-origin: top; transition: transform 1.6s var(--ease-out) 0.2s; }
  .tl.is-in .tl__line i { transform: scaleY(1); }
  .it { position: relative; }
  .it::before { content: ""; position: absolute; inset-inline-start: -2.6rem; inset-block-start: 50%; translate: 0 -50%; inline-size: 1.9rem; block-size: 1.9rem; border-radius: 50%; background: var(--paper); border: 2px solid var(--rule); box-sizing: border-box; z-index: 1; transition: border-color var(--dur-base) ease, background var(--dur-base) ease; }
  .it--live::before { background: var(--accent); border-color: var(--accent); }
  .it.reveal { transition-duration: 0.6s; }
  .it__inner {
    display: grid; grid-template-columns: 3rem 1fr auto; gap: 1rem;
    align-items: center; padding: 0.95rem 1.25rem;
    background: var(--surface); border: 1px solid var(--rule);
    border-radius: var(--r-card); text-decoration: none; color: inherit;
  }
  a.it__inner { transition: border-color var(--dur-fast) ease, box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  a.it__inner:hover { border-color: var(--accent); box-shadow: var(--shadow-2); color: inherit; transform: translateX(-4px); }
  .it__arrow { display: inline-block; opacity: 0; transform: translateX(6px); transition: opacity var(--dur-base) ease, transform var(--dur-base) var(--ease-out); }
  a.it__inner:hover .it__arrow { opacity: 1; transform: none; }
  .it--soon .it__inner { background: transparent; border-style: dashed; }
  .it__n { font-family: var(--font-display); font-size: var(--t-base); color: var(--ink-faint); }
  .it--live .it__n { color: var(--accent-deep); }
  .it__body { display: flex; flex-direction: column; gap: 0.1rem; min-inline-size: 0; }
  .it__t { font-weight: 500; color: var(--ink-strong); }
  .it--soon .it__t { color: var(--ink-muted); font-weight: 400; }
  .it__note { font-size: var(--t-sm); color: var(--ink-faint); font-weight: 300; line-height: 1.55; }
  .it__state { font-size: var(--t-xs); color: var(--accent-deep); font-weight: 500; white-space: nowrap; }
  .it__state--soon { color: var(--ink-faint); font-weight: 400; }

  @media (max-width: 640px) {
    .tl { padding-inline-start: 1.9rem; }
    .tl__line { inset-inline-start: 0.6rem; }
    .it::before { inset-inline-start: -1.9rem; inline-size: 1.4rem; block-size: 1.4rem; }
    .it__inner { grid-template-columns: 2.2rem 1fr; row-gap: 0.3rem; }
    .it__state { grid-column: 2; }
  }
</style>
