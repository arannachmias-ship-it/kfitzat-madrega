---
import Base from '../layouts/Base.astro';
import SignupBand from '../components/SignupBand.astro';
import Il from '../components/Il.astro';
import { getCollection } from 'astro:content';
import { STAGES, TOTAL_LESSONS } from '../data/track';

const live = (await getCollection('maslul', (e) => e.data.published))
  .sort((a, b) => a.data.stage - b.data.stage || a.data.order - b.data.order);
const featured = live.slice(0, 4);
const liveCount = live.length;

// מה כבר אפשר: ההדגמות החיות עולות לדף הבית, כדי שהמבקר יראה מה AI עושה ולא רק יקרא עליו
const demos = (await getCollection('efshar', (e) => e.data.published))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// 100 הדקות של סדנת ההתנעה: ארבעה חלקים והפסקה באמצע, כמו במערך
const rounds = [
  { il: 'spark', n: 'חלק 1', h: 'פוסטר לצוות', d: 'מצלמים, מבקשים, ולכל שולחן יש פוסטר של סרט על הצוות שלו. על המסך הגדול, מול כולם.' },
  { il: 'music', n: 'חלק 2', h: 'שיר וסרטון', d: 'כל שולחן כותב המנון משלו ושולח אותו הביתה. ובינתיים הפוסטרים מתחילים לזוז.' },
  { il: 'talk', n: 'חלק 3 · אחרי ההפסקה', h: 'ומה זה עושה לעבודה', d: 'מדברים איתה דרך המצלמה, תופסים אותה טועה בביטחון, ומגלים למה הידע שלכם שווה עכשיו יותר.' },
  { il: 'manager', n: 'חלק 4', h: 'הכלי שלכם', d: 'כולם מתאמנים מול כלי שנבנה רק לצוות שלכם, עם יעד משותף על המסך. כשמגיעים אליו, החדר חוגג.' },
];
---
<Base
  title="הכשרות והטמעת AI בארגונים · Nexadapt"
  description="סדנאות AI לארגונים וליווי הטמעה, נבנות סביב הצוות שלכם. ומסלול לימוד AI פתוח וחינמי. ארן נחמיאס ומתי מצוינים."
>
  <!-- hero: the lecture's look. deep band, one illustration, one promise -->
  <section class="heroBand band-hero">
    <div class="wrap hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__copy">
        <p class="hero__kicker rise"><span class="hero__dot" aria-hidden="true"></span>סדנאות AI לארגונים</p>
        <h1 class="hero__title rise">תראו מה <span class="hero__ai">AI</span> עושה עם העבודה שלכם.</h1>
        <p class="hero__sub rise">סדנה של 100 דקות שבה כל הצוות יוצר בעצמו, מהטלפון: פוסטר, שיר, וכלי שנבנה רק בשבילו. יוצאים עם חיוך, ועם חשק לנסות שוב מחר.</p>
        <div class="hero__actions rise">
          <a class="btn btn--primary" href="/hatnaa">להביא אותנו לארגון <span class="btn__arrow" aria-hidden="true">←</span></a>
          <a class="btn btn--ghostOnDeep" href={live[0] ? `/maslul/${live[0].id}` : '/maslul'}>ללמוד לבד, בחינם</a>
        </div>
        <a class="hero__who rise" href="/anachnu">
          <span class="hero__faces">
            <img src="/anachnu/aran.webp" width="96" height="96" alt="" loading="eager" decoding="async" />
            <img src="/anachnu/mati.webp" width="96" height="96" alt="" loading="eager" decoding="async" />
          </span>
          <span class="hero__whoT"><strong>ארן נחמיאס ומתי מצוינים</strong>שני מנחים, יותר מ־20 שנה מול קבוצות בארגונים</span>
        </a>
      </div>
      <div class="hero__media">
        <Il name="hero" size={470} eager alt="איור: טלפון שמתוכו פורצים תווים, קלאפר של סרט, מצלמה, תמונה ובועת שיחה" />
      </div>
    </div>
  </section>

  <!-- two paths: what we sell, and what is free -->
  <section class="wrap paths" aria-label="שתי דרכים">
    <a class="path path--lead reveal" href="/irgunim">
      <span class="path__tag">לארגונים</span>
      <span class="path__h">להביא אותנו אליכם</span>
      <span class="path__d">מתחילים בסדנת התנעה שמדליקה את כל הצוות. מי שרוצה עוד, ממשיך לסדנה מעשית, לתוכנית הכשרה או לליווי. הכול נבנה סביב הצוות שלכם.</span>
      <span class="path__cta">לתוכניות <span aria-hidden="true">←</span></span>
    </a>
    <a class="path reveal" href="/maslul">
      <span class="path__tag path__tag--quiet">חינם</span>
      <span class="path__h">ללמוד לבד</span>
      <span class="path__d">{TOTAL_LESSONS} שיעורים קצרים, מ"מה זה בכלל" ועד הטמעה בארגון. פתוחים לכולם, בלי הרשמה ובלי תשלום.</span>
      <span class="path__cta">למסלול <span aria-hidden="true">←</span></span>
    </a>
  </section>

  <!-- the kickoff lecture: what actually happens in the room -->
  <section class="ninety band-hero" aria-labelledby="ninety-title">
    <div class="wrap">
      <div class="ninety__head">
        <p class="ninety__kicker">סדנת ההתנעה</p>
        <h2 id="ninety-title" class="ninety__title">100 דקות. אף אחד לא רק מקשיב.</h2>
        <p class="ninety__sub">שתי מטרות: שהצוות ייהנה, ושיגלה מה AI יודע לעשות. ארבעה חלקים והפסקה באמצע, הכול מהטלפון ובלי שום ידע קודם. גם מי שבטוח שזה לא בשבילו.</p>
        <p class="ninety__first"><span class="hero__dot" aria-hidden="true"></span>כמו שעשינו עם סוכני השטח של דנשר.</p>
      </div>
      <ol class="ninety__grid" data-stagger="110">
        {rounds.map((r) => (
          <li class="round reveal">
            <Il name={r.il} size={190} still />
            <span class="round__n">{r.n}</span>
            <h3 class="round__h">{r.h}</h3>
            <p class="round__d">{r.d}</p>
          </li>
        ))}
      </ol>
      <div class="ninety__end reveal">
        <Il name="team" size={230} />
        <div>
          <h3 class="ninety__endH">ובסוף, סרט אחד מכל מה שהצוות יצר.</h3>
          <p class="ninety__endD">הפוסטרים, השירים והסרטונים מתחברים לסרט של דקה וחצי. וברגע האחרון תמונת הקבוצה בוואטסאפ מתחלפת, בכל הטלפונים בבת אחת. יוצאים עם משהו לשלוח הביתה, ועם חשק לנסות שוב מחר.</p>
          <a class="btn btn--onDeep" href="/hatnaa">כל הפרטים על הסדנה <span class="btn__arrow" aria-hidden="true">←</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- what AI already does: the live demos, shown up front -->
  {demos.length > 0 && (
    <section class="wrap wow" aria-labelledby="wow-title">
      <div class="wow__head">
        <h2 id="wow-title" class="wow__title">מה AI כבר עושה בארגונים</h2>
        <p class="wow__sub">שלושה דברים שבנינו בפועל, כל אחד בשעה או פחות ובלי פיתוח. אפשר לנסות אותם כאן באתר, עכשיו.</p>
      </div>
      <div class="wow__grid" data-stagger="90">
        {demos.map((d) => (
          <a class="wow__card reveal" href={`/efshar/${d.id}`}>
            <span class="wow__tag"><span class="wow__dot" aria-hidden="true"></span>הדגמה חיה · {d.data.built} עבודה</span>
            <span class="wow__h">{d.data.title}</span>
            <span class="wow__d">{d.data.after}</span>
            <span class="wow__cta">לנסות בעצמכם <span aria-hidden="true">←</span></span>
          </a>
        ))}
      </div>
      <p class="wow__all"><a href="/efshar" class="link-draw">כל ההדגמות ←</a></p>
    </section>
  )}

  <!-- the track: the anchor of the page -->
  <section class="track band-deep" aria-labelledby="track-title">
    <div class="wrap">
      <div class="track__head">
        <div>
          <h2 id="track-title" class="track__title">המסלול <span class="track__free">חינם</span></h2>
          <p class="track__sub">
            {TOTAL_LESSONS} שיעורים בחמישה שלבים, מהאפס עד הטמעה בארגון. פתוח לכולם, בלי תשלום ובלי הרשמה.{' '}
            {live.length} כבר באוויר, שיעור חדש בכל שבוע.
          </p>
          <p class="track__layers"><span>{TOTAL_LESSONS} שיעורים</span><i aria-hidden="true">·</i><span>7 כלים, כל אחד בשלב שלו</span><i aria-hidden="true">·</i><span>הדגמות חיות</span></p>
        </div>
        <a class="track__all link-draw" href="/maslul">כל המסלול ←</a>
      </div>

      <ol class="track__grid" data-stagger="90">
        {featured.map((l) => (
          <li class:list={['lesson', 'reveal', { 'lesson--flag': l.data.interactive }]}>
            <a href={`/maslul/${l.id}`} class="lesson__link" data-spot>
              <span class="lesson__n" transition:name={`lesson-n-${l.id}`}>{String(l.data.stage)}.{String(l.data.order)}</span>
              <span class="lesson__body">
                <span class="lesson__title">{l.data.title}</span>
                <span class="lesson__note">{l.data.kicker}</span>
                <span class="lesson__meta">
                  {l.data.interactive ? 'אינטראקטיבי · ' : ''}{l.data.readingTime} דקות קריאה
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>

      <div class="track__progress reveal" role="img" aria-label={`${liveCount} מתוך ${TOTAL_LESSONS} שיעורים באוויר`}>
        <div class="track__rail"><i style={`--w:${(liveCount / TOTAL_LESSONS) * 100}%`}></i></div>
        <div class="track__railLbl"><span>{liveCount} שיעורים באוויר</span><span>{TOTAL_LESSONS} במסלול</span></div>
      </div>

      <div class="track__stages">
        {STAGES.map((s) => (
          <div class="stagechip">
            <span class="stagechip__n">שלב {s.n}</span>
            <span class="stagechip__t">{s.title}</span>
            <span class="stagechip__c">{s.items.length} שיעורים</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- proof -->
  <section class="proof" aria-label="נתונים">
    <div class="wrap proof__grid">
      <div class="proof__cell">
        <p class="proof__n" data-count="88" data-suffix="%">88%</p>
        <p class="proof__t">מ־3,000 מתנדבים שכל העבודה שלהם הייתה פנים אל פנים עברו לזום תוך 30 יום, ושביעות רצון המשפחות עלתה מ־90% ל־94%</p>
      </div>
      <div class="proof__cell">
        <p class="proof__n" data-count="20" data-suffix="+ שנה">20+ שנה</p>
        <p class="proof__t">ותק של כל אחד משנינו בניהול, תפעול והטמעת טכנולוגיה בארגונים.</p>
      </div>
      <div class="proof__cell">
        <p class="proof__n" data-count="80" data-suffix="%">80%</p>
        <p class="proof__t">מזמן סדנת ההתנעה הצוות עובד בידיים. כמעט אף אחד לא יושב ומקשיב.</p>
      </div>
    </div>
  </section>

  <!-- the staircase -->
  <section class="wrap stairs" aria-labelledby="stairs-title">
    <h2 id="stairs-title" class="stairs__title">שלוש מדרגות. אפשר להתחיל בכל אחת.</h2>
    <p class="stairs__sub">אחד משלושת המשפטים האלה כנראה נאמר אצלכם בחודש האחרון.</p>
    <div class="stairs__grid" data-stagger="120">
      <article class="step reveal">
        <h3 class="step__q">"צריכים לעשות משהו בנושא AI"</h3>
        <p class="step__d">יש רצון, עוד אין כיוון. כאן כולם יוצרים בעצמם בפעם הראשונה, ומגלים שזה גם כיף.</p>
        <p class="step__tag">סדנת התנעה</p>
      </article>
      <article class="step step--mid reveal">
        <h3 class="step__q">"כולם התלהבו. עכשיו רוצים לעשות"</h3>
        <p class="step__d">יש חשק, עכשיו צריך לדעת איך. כל אחד בונה משהו על העבודה שלו.</p>
        <p class="step__tag">סדנה מעשית</p>
      </article>
      <article class="step step--top reveal">
        <h3 class="step__q">"קנינו רישיונות ואף אחד לא נוגע"</h3>
        <p class="step__d">הכלים כבר שם. עכשיו בונים יחד את ההרגלים: מי עושה מה, ואיך יודעים שזה עובד.</p>
        <p class="step__tag step__tag--accent">ליווי הטמעה</p>
      </article>
    </div>
  </section>

  <!-- programs: one sentence and a link. the full table lives on /irgunim -->
  <section class="wrap programs" aria-labelledby="programs-title">
    <h2 id="programs-title" class="programs__title">מתחילים בסדנה אחת. ממשיכים כמה שתרצו.</h2>
    <p class="programs__p">סדנת התנעה, סדנה מעשית, סדנת יום מלא, תוכנית הכשרה או ליווי הטמעה. קודם מקשיבים לכם, ואז בונים את התוכנית סביב הצוות והעבודה האמיתית שלכם.</p>
    <p><a href="/irgunim" class="programs__link link-draw">לכל התוכניות ←</a></p>
  </section>

  <SignupBand />
</Base>

<script>
  // spotlight border: two CSS variables follow the pointer, nothing else runs
  function initSpot() {
    document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }
  initSpot();
  document.addEventListener('astro:page-load', initSpot);
</script>

<style>
  /* hero */
  .heroBand { position: relative; overflow: hidden; }
  .hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: center; padding-block: 3.5rem 3.75rem; position: relative; isolation: isolate; }
  .hero__glow {
    position: absolute; z-index: -1; pointer-events: none;
    inset-block-start: -35%; inset-inline-start: -12%; inline-size: 55%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(198, 214, 63, 0.2), transparent 70%);
    filter: blur(48px);
    animation: heroDrift 16s ease-in-out infinite alternate;
  }
  @keyframes heroDrift { to { transform: translate(14%, 18%) scale(1.15); } }
  .hero__kicker { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--t-sm); font-weight: 500; color: var(--accent); margin-block-end: 0.9rem; }
  .hero__dot { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background: var(--accent); animation: heroPulse 2.2s ease-in-out infinite; }
  @keyframes heroPulse { 50% { box-shadow: 0 0 0 6px rgba(198, 214, 63, 0.28); } }
  .hero__ai { position: relative; display: inline-block; white-space: nowrap; color: var(--accent); }
  .hero__ai::after {
    content: ""; position: absolute; inset-inline: 0; bottom: 0.06em; height: 0.12em; border-radius: 2px;
    background: var(--accent); transform: scaleX(0); transform-origin: right;
    animation: heroUnderline 0.7s var(--ease-out) 1.1s forwards;
  }
  @keyframes heroUnderline { to { transform: scaleX(1); } }
  .hero__title { font-size: clamp(2.5rem, 5.4vw, 3.9rem); margin-block-end: 1.1rem; }
  .hero__sub { font-size: var(--t-xl); line-height: 1.6; color: #C2D0D4; font-weight: 300; max-inline-size: 38ch; margin-block-end: 1.9rem; }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .hero__who { display: inline-flex; align-items: center; gap: 0.9rem; margin-block-start: 1.6rem; text-decoration: none; color: #C2D0D4; }
  .hero__who:hover { color: var(--ink-on-deep); }
  .hero__faces { display: flex; }
  .hero__faces img { inline-size: 3.25rem; block-size: 3.25rem; border-radius: 50%; object-fit: cover; object-position: top; border: 2px solid var(--hero); box-shadow: 0 0 0 2px var(--accent); }
  .hero__faces img + img { margin-inline-start: -0.7rem; }
  .hero__whoT { display: flex; flex-direction: column; font-size: var(--t-sm); line-height: 1.45; font-weight: 300; }
  .hero__whoT strong { color: var(--ink-on-deep); font-weight: 500; }
  @media (max-width: 880px) {
    .hero { grid-template-columns: 1fr; gap: 1rem; padding-block: 2.5rem 2rem; }
    .hero__media { --il: 300px; }
    .hero__media :global(.il) { inline-size: min(300px, 80%); }
    .hero__glow { inline-size: 80%; inset-inline-start: -30%; inset-block-start: -45%; }
  }

  /* two paths */
  .paths { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 1rem; padding-block: 2.5rem 3.5rem; }
  .path { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem 1.6rem; border-radius: var(--r-card); text-decoration: none; color: var(--ink); background: var(--surface); border: 1px solid var(--rule); box-shadow: var(--shadow-1); transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-fast) ease; }
  .path:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); color: var(--ink); }
  .path--lead { border-color: var(--accent); box-shadow: var(--shadow-2); }
  .path__tag { align-self: flex-start; font-size: var(--t-xs); font-weight: 700; padding: 0.2rem 0.7rem; border-radius: 999px; background: var(--accent); color: var(--accent-ink); }
  .path__tag--quiet { background: var(--surface-sunk); color: var(--ink-muted); }
  .path__h { font-family: var(--font-display); font-size: var(--t-xl); color: var(--ink-strong); }
  .path__d { color: var(--ink-muted); font-size: var(--t-sm); line-height: 1.6; }
  .path__cta { margin-block-start: 0.4rem; font-weight: 500; color: var(--ink-strong); }
  .path:hover .path__cta { color: var(--accent-deep); }
  @media (max-width: 720px) { .paths { grid-template-columns: 1fr; } }

  /* the 90 minutes */
  .ninety { padding-block: 3.75rem 4rem; margin-block-end: 3.5rem; }
  .ninety__head { margin-block-end: 2rem; }
  .ninety__kicker { color: var(--accent); font-weight: 500; font-size: var(--t-sm); margin-block-end: 0.4rem; }
  .ninety__title { font-size: clamp(2rem, 4.2vw, 2.9rem); margin-block-end: 0.7rem; }
  .ninety__sub { color: #C2D0D4; font-weight: 300; font-size: var(--t-lg); max-inline-size: 56ch; margin: 0; }
  .ninety__first { display: flex; align-items: center; gap: 0.55rem; margin: 1rem 0 0; font-size: var(--t-sm); color: var(--ink-on-deep); }
  .ninety__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .round { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.5rem 1.2rem 1.4rem; border: 1px solid var(--hero-edge); border-radius: var(--r-card); transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-fast) ease, opacity var(--dur-slow) var(--ease-out); }
  .round:hover { transform: translateY(-4px); border-color: var(--accent); }
  .round:hover :global(.il img) { transform: scale(1.06) rotate(-2deg); }
  .round :global(.il img) { transition: transform var(--dur-base) var(--ease-spring); }
  .round__n { color: var(--accent); font-size: var(--t-xs); font-weight: 500; }
  .round__h { font-size: var(--t-xl); }
  .round__d { color: #C2D0D4; font-size: var(--t-sm); font-weight: 300; line-height: 1.6; margin: 0; }
  .ninety__end { display: grid; grid-template-columns: auto 1fr; gap: 2rem; align-items: center; margin-block-start: 2.25rem; padding-block-start: 2rem; border-block-start: 1px solid var(--hero-edge); }
