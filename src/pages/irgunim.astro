---
import Base from '../layouts/Base.astro';
import SignupBand from '../components/SignupBand.astro';

const programs = [
  {
    id: 'hartsaa',
    name: 'הרצאת פתיחה',
    len: '60 עד 90 דקות', group: 'עד 200 משתתפים', hosts: 'מנחה אחד', hands: '20%',
    gets: 'מילון משותף ונקודת פתיחה לכל הארגון, ותמונה ברורה של מה השלב הבא.',
    price: '[טווח מחיר]',
    agenda: [
      ['00:00 – 00:15', 'מה המכונה הזו עושה, ולמה היא ממציאה'],
      ['00:15 – 00:35', 'הדגמה חיה על מסמך אמיתי מהארגון שלכם, כולם מריצים במקביל'],
      ['00:35 – 01:00', 'איפה זה כבר עובד בארגונים דומים, ואיפה זה נכשל'],
      ['01:00 – 01:20', 'מה מותר ומה אסור להכניס, בקצרה'],
      ['01:20 – 01:30', 'שאלות, ומה אפשר לעשות מחר בבוקר'],
    ],
  },
  {
    id: 'sadna',
    name: 'סדנת ידיים',
    len: '4 שעות', group: '10 עד 25 משתתפים', hosts: 'מנחה אחד או שניים', hands: '70%',
    gets: 'כל משתתף יוצא עם שני תהליכים מהעבודה שלו שהוא בנה בעצמו, על מסמכים אמיתיים שהביא.',
    price: '[טווח מחיר]',
    agenda: [
      ['00:00 – 00:30', 'הבסיס: איך מנסחים בקשה שמחזירה משהו שאפשר להשתמש בו'],
      ['00:30 – 01:30', 'עבודה: כל אחד על מסמך שהביא. אנחנו עוברים בין השולחנות'],
      ['01:30 – 01:45', 'הפסקה'],
      ['01:45 – 02:45', 'התהליך השני: משהו חוזר מהשבוע של כל משתתף'],
      ['02:45 – 03:30', 'מה שובר את זה: המצאות, פרטיות, ותלות באדם אחד'],
      ['03:30 – 04:00', 'כל אחד מציג מה בנה, ומה הוא לוקח ליום שני'],
    ],
  },
  {
    id: 'yom',
    name: 'יום מרוכז לצוות גדול',
    len: 'יום עבודה', group: '25 עד 50 משתתפים', hosts: 'שני מנחים', hands: '70%',
    gets: 'פיצול לשתי קבוצות עבודה במקביל, כך שגם בקבוצה גדולה יש ליווי אישי אמיתי.',
    price: '[טווח מחיר]',
    agenda: [
      ['בוקר', 'מפגש משותף: הבסיס, וההדגמה החיה'],
      ['אמצע היום', 'פיצול לשתי קבוצות. כל מנחה עם קבוצה, עבודה על חומרים אמיתיים'],
      ['אחר הצהריים', 'החלפה: כל קבוצה מקבלת את המנחה השני ואת הזווית השנייה'],
      ['סיום', 'מפגש משותף: מה נבנה, מה נשאר פתוח, ומה התוכנית לחודש הקרוב'],
    ],
  },
  {
    id: 'sidra',
    name: 'סדרת הכשרה',
    len: '3 עד 4 מפגשים', group: '10 עד 20 משתתפים', hosts: 'שני מנחים', hands: '65%',
    gets: 'צוות שעובד אחרת, לא צוות שהתלהב פעם אחת. בין מפגש למפגש יש משימה על העבודה האמיתית.',
    price: '[טווח מחיר]',
    agenda: [
      ['מפגש 1', 'הבסיס והתהליך הראשון. משימה לשבועיים'],
      ['מפגש 2', 'מה עבד ומה נתקע אצל כל אחד, ואז התהליך השני'],
      ['מפגש 3', 'לחבר בין הכלים: מטריגר לפעולה, בלי קוד'],
      ['מפגש 4', 'ממשל, מדידה, ותוכנית להמשך בלעדינו'],
    ],
  },
  {
    id: 'livuy',
    name: 'ליווי הטמעה',
    len: '3 עד 6 חודשים', group: 'הנהלה וצוותים', hosts: 'שני מנחים', hands: 'רוב העבודה',
    gets: 'תהליכים שרצים, נמדדים, ולא נשענים עלינו. מסמך מדיניות כתוב ותוכנית 90 יום.',
    price: '[טווח מחיר]',
    agenda: [
      ['שבועות 1–2', 'מיפוי: איפה הזמן הולך, אילו מערכות יש, מה כבר ניסיתם'],
      ['שבועות 3–6', 'שני תהליכים ראשונים מקצה לקצה, עם בעלים מוגדר לכל אחד'],
      ['שבועות 7–10', 'הכשרת הצוותים על מה שנבנה, ומדיניות כתובה'],
      ['שבועות 11+', 'מדידת אימוץ, תיקונים, והעברת בעלות אליכם'],
    ],
  },
];
---
<Base
  title="תוכניות לארגונים · קפיצת מדרגה"
  description="הרצאות, סדנאות ידיים וליווי הטמעת AI בארגונים. אג'נדה מלאה לכל תוכנית, כולל אחוז העבודה בידיים."
>
  <section class="wrap head">
    <h1 class="head__title">כשאתם רוצים אותנו בחדר</h1>
    <p class="head__sub">
      חמש תוכניות, ולכל אחת אג'נדה מלאה עם חלוקת זמנים, פתוחה לקריאה לפני שמדברים.
      לכל תוכנית כתוב גם כמה מהזמן הוא עבודה בידיים, כי זה ההבדל היחיד שבאמת משנה.
    </p>
    <div class="head__pair">
      <p><strong>שני מנחים, לא מרצה אחד.</strong> בקבוצה של 40 איש זה אומר שאפשר לפצל לשתי קבוצות עבודה במקביל ולסיים במפגש משותף, במקום לתת לכולם חוויה של הרצאה.</p>
      <p><strong>שנינו מלמדים כבר כעשרים שנה.</strong> פסיכומטרי, קצינים, תיכון, מכללה, וקבוצות שבהן תמיד יש שניים־שלושה שנשארים מאחור ומתביישים לומר. אלה בדיוק האנשים שרוב הספקים מאבדים.</p>
    </div>
  </section>

  <section class="wrap compare" aria-labelledby="compare-title">
    <h2 id="compare-title" class="sr">השוואה בין התוכניות</h2>
    <div class="ctab">
      <div class="crow crow--head"><span>תוכנית</span><span>אורך</span><span>קבוצה</span><span>מנחים</span><span>ידיים</span><span>מחיר</span></div>
      {programs.map((p) => (
        <a class="crow" href={`#${p.id}`}>
          <span class="crow__name">{p.name}</span><span>{p.len}</span><span>{p.group}</span><span>{p.hosts}</span>
          <span class="crow__hands">{p.hands}</span><span class="crow__price">{p.price}</span>
        </a>
      ))}
    </div>
  </section>

  {programs.map((p) => (
    <section class="wrap prog" id={p.id} aria-labelledby={`${p.id}-t`}>
      <div class="prog__side">
        <h2 id={`${p.id}-t`} class="prog__name">{p.name}</h2>
        <dl class="prog__facts">
          <div><dt>אורך</dt><dd>{p.len}</dd></div>
          <div><dt>גודל קבוצה</dt><dd>{p.group}</dd></div>
          <div><dt>מנחים</dt><dd>{p.hosts}</dd></div>
          <div><dt>עבודה בידיים</dt><dd class="hi">{p.hands}</dd></div>
          <div><dt>טווח מחיר</dt><dd>{p.price}</dd></div>
        </dl>
        <p class="prog__gets">{p.gets}</p>
      </div>
      <div class="prog__agenda">
        <p class="prog__agendaLabel">האג'נדה</p>
        {p.agenda.map(([t, what]) => (
          <div class="ag"><span class="ag__t">{t}</span><span class="ag__w">{what}</span></div>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap ask">
    <h2 class="ask__title">איך מתחילים</h2>
    <p class="ask__body">
      כותבים לנו מה גודל הצוות, מה כבר ניסיתם, ומה ההנהלה ביקשה. אנחנו חוזרים עם המלצה לתוכנית אחת,
      ואם אנחנו חושבים שאתם לא צריכים אותנו עדיין, נגיד גם את זה.
    </p>
    <p><a class="btn btn--primary" href="mailto:arannachmias@gmail.com?subject=פנייה%20מהאתר">כתבו לנו</a></p>
  </section>

  <SignupBand />
</Base>

<style>
  .sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
  .head { padding-block: 3rem 2.25rem; }
  .head__title { font-size: clamp(2.3rem, 5vw, 3.2rem); margin-block-end: 0.9rem; }
  .head__sub { font-size: var(--t-xl); color: var(--ink-muted); font-weight: 300; max-inline-size: 58ch; margin-block-end: 1.75rem; }
  .head__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .head__pair p { color: var(--ink-muted); font-weight: 300; font-size: var(--t-sm); margin: 0; }
  .head__pair strong { color: var(--ink-strong); font-weight: 700; }
  @media (max-width: 780px) { .head__pair { grid-template-columns: 1fr; gap: 1rem; } }

  .compare { padding-block-end: 2.5rem; }
  .ctab { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r-card); overflow: hidden; }
  .crow { display: grid; grid-template-columns: 1.4fr 1fr 1fr 0.9fr 0.6fr 0.9fr; gap: 1rem; padding: 0.95rem 1.35rem; border-block-end: 1px solid var(--rule); font-size: var(--t-sm); color: var(--ink-muted); text-decoration: none; align-items: center; }
  a.crow:hover { background: var(--surface-sunk); color: var(--ink-muted); }
  .crow:last-child { border-block-end: none; }
  .crow--head { background: var(--surface-sunk); font-size: var(--t-xs); color: var(--ink-faint); }
  .crow__name { font-weight: 700; color: var(--ink-strong); }
  .crow__hands { font-weight: 700; color: var(--ink-strong); }
  .crow__price { color: var(--ink-faint); }
  @media (max-width: 900px) { .crow { grid-template-columns: 1.3fr 1fr; row-gap: 0.3rem; } .crow--head { display: none; } }

  .prog { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 3rem; padding-block: 2.25rem; border-block-start: 1px solid var(--rule); scroll-margin-block-start: 1.5rem; }
  .prog__name { font-size: var(--t-2xl); margin-block-end: 1.1rem; }
  .prog__facts { margin: 0 0 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .prog__facts > div { display: grid; grid-template-columns: 9rem 1fr; gap: 0.75rem; font-size: var(--t-sm); }
  .prog__facts dt { color: var(--ink-faint); }
  .prog__facts dd { margin: 0; color: var(--ink); }
  .prog__facts .hi { color: var(--ink-strong); font-weight: 700; }
  .prog__gets { color: var(--ink-muted); font-weight: 300; font-size: var(--t-sm); margin: 0; }
  .prog__agendaLabel { font-size: var(--t-xs); color: var(--ink-faint); margin-block-end: 0.6rem; }
  .ag { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1rem; padding-block: 0.7rem; border-block-end: 1px solid var(--rule); font-size: var(--t-sm); }
  .ag:last-child { border-block-end: none; }
  .ag__t { color: var(--accent-deep); font-weight: 500; font-variant-numeric: tabular-nums; }
  .ag__w { color: var(--ink); }
  @media (max-width: 820px) { .prog { grid-template-columns: 1fr; gap: 1.5rem; } .ag { grid-template-columns: 1fr; gap: 0.15rem; } }

  .ask { padding-block: 3rem 4rem; border-block-start: 1px solid var(--rule); }
  .ask__title { font-size: var(--t-2xl); margin-block-end: 0.8rem; }
  .ask__body { color: var(--ink-muted); font-weight: 300; max-inline-size: 58ch; margin-block-end: 1.5rem; font-size: var(--t-lg); }
</style>
