---
import Base from '../layouts/Base.astro';
import SignupBand from '../components/SignupBand.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactWays from '../components/ContactWays.astro';

// לכל תוכנית: במה היא נוגעת, בלי לו״ז. את הסדר ואת הדגשים בונים עם הלקוח בשיחה.
const programs = [
  {
    id: 'hartsaa',
    name: 'הרצאת התנעה',
    len: '60 עד 90 דקות', group: 'עד 200 משתתפים', hosts: 'מנחה אחד', hands: '20%',
    gets: 'הרגע שבו כל הארגון רואה מה AI עושה עם העבודה שלו. יוצאים עם חשק, עם שפה משותפת, ועם דבר אחד לנסות כבר מחר.',
    topics: [
      'הדגמה חיה על מסמך אמיתי מהארגון שלכם, וכולם מריצים במקביל',
      'איך זה עובד, ולמה לפעמים הוא ממציא',
      'איפה זה כבר עובד בארגונים דומים לשלכם',
      'מה מותר ומה אסור להכניס, בקצרה',
      'מה אפשר לנסות כבר מחר בבוקר',
    ],
  },
  {
    id: 'sadna',
    name: 'סדנה מעשית',
    len: '4 שעות', group: '10 עד 25 משתתפים', hosts: 'מנחה אחד או שניים', hands: '70%',
    gets: 'כל משתתף יוצא עם שני תהליכים מהעבודה שלו שהוא בנה בעצמו, על מסמכים אמיתיים שהביא.',
    topics: [
      'איך מנסחים בקשה שמחזירה משהו שאפשר להשתמש בו',
      'עבודה אישית על מסמך שכל אחד הביא, ואנחנו עוברים בין השולחנות',
      'תהליך שני: משהו שחוזר בשבוע של כל משתתף',
      'מה שובר את זה: המצאות, פרטיות, ותלות באדם אחד',
      'כל אחד מציג מה בנה, ומה הוא לוקח ליום שני',
    ],
  },
  {
    id: 'yom',
    name: 'סדנת יום מלא',
    len: 'יום עבודה', group: '25 עד 50 משתתפים', hosts: 'שני מנחים', hands: '70%',
    gets: 'פיצול לשתי קבוצות עבודה במקביל, כך שגם בקבוצה גדולה יש ליווי אישי אמיתי.',
    topics: [
      'פתיחה משותפת: הבסיס, והדגמה חיה',
      'פיצול לשתי קבוצות, כל מנחה עם קבוצה, עבודה על חומרים אמיתיים',
      'החלפה בין הקבוצות, כך שכל אחד מקבל את שני המנחים ואת שתי הזוויות',
      'סיום משותף: מה נבנה, ומה התוכנית לחודש הקרוב',
    ],
  },
  {
    id: 'sidra',
    name: 'תוכנית הכשרה',
    len: '3 עד 4 מפגשים', group: '10 עד 20 משתתפים', hosts: 'שני מנחים', hands: '65%',
    gets: 'החשק מההתחלה הופך להרגל של כל הצוות. בין מפגש למפגש יש משימה על העבודה האמיתית.',
    topics: [
      'הבסיס ותהליך ראשון על העבודה האמיתית',
      'משימה בין המפגשים, ובדיקה משותפת של מה עבד ומה נתקע',
      'לחבר בין הכלים: מטריגר לפעולה, בלי קוד',
      'ממשל, מדידה, ותוכנית להמשך בלעדינו',
    ],
  },
  {
    id: 'livuy',
    name: 'ליווי הטמעה',
    len: '3 עד 6 חודשים', group: 'הנהלה וצוותים', hosts: 'שני מנחים', hands: 'רוב העבודה',
    gets: 'תהליכים שרצים, נמדדים, ולא נשענים עלינו. מסמך מדיניות כתוב ותוכנית 90 יום.',
    topics: [
      'מיפוי: איפה הזמן הולך, אילו מערכות יש, מה כבר ניסיתם',
      'שני תהליכים ראשונים מקצה לקצה, עם בעלים מוגדר לכל אחד',
      'הכשרת הצוותים על מה שנבנה, ומדיניות כתובה',
      'מדידת אימוץ, תיקונים, והעברת הבעלות אליכם',
    ],
  },
];
---
<Base
  title="תוכניות לארגונים · Nexadapt"
  description="הרצאות, סדנאות מעשיות וליווי הטמעת AI בארגונים. לכל תוכנית: במה היא נוגעת, וכמה מהזמן הוא עבודה בידיים."
>
  <section class="wrap head head--photo">
    <div class="head__text">
    <h1 class="head__title">כשאתם רוצים אותנו בחדר</h1>
    <p class="head__sub">
      חמש תוכניות, מהרצאה שמדליקה את כל הארגון ועד ליווי שהופך את זה לשגרה.
      לכל אחת כתוב במה היא נוגעת וכמה מהזמן הוא עבודה בידיים. את הסדר ואת הדגשים בונים יחד איתכם.
    </p>
    <div class="head__pair">
      <p><strong>שני מנחים, לא מרצה אחד.</strong> כך אפשר לפצל לשתי קבוצות עבודה במקביל, גם כשהקבוצה לא גדולה, ולסיים במפגש משותף, במקום לתת לכולם חוויה של הרצאה.</p>
      <p><strong>שנינו מלמדים כבר כעשרים שנה.</strong> פסיכומטרי, קצינים, תיכון, מכללה, וקבוצות שבהן תמיד יש שניים־שלושה שנשארים מאחור ומתביישים לומר. אלה בדיוק האנשים שרוב הספקים מאבדים.</p>
    </div>
    </div>
    <div class="head__media rise">
      <img src="/photos/irgunim.webp" width="1200" height="800" alt="צוות של שמונה עובדים רוכן יחד על מסך מחשב נייד בחדר ישיבות, באמצע סדנה" fetchpriority="high" decoding="async" />
    </div>
  </section>

  <section class="wrap list" aria-labelledby="list-title">
    <h2 id="list-title" class="sr">התוכניות</h2>
    <div class="plist" data-stagger="80">
      {programs.map((p, i) => (
        <details class="prog reveal" id={p.id} open={i === 0}>
          <summary class="prog__row">
            <span class="prog__name">{p.name}</span>
            <span class="prog__cell"><span class="prog__k">אורך</span>{p.len}</span>
            <span class="prog__cell"><span class="prog__k">קבוצה</span>{p.group}</span>
            <span class="prog__cell prog__cell--hands"><span class="prog__k">עבודה בידיים</span><span class="prog__hands">{p.hands}</span>
              <span class="meter" aria-hidden="true"><i style={`--w:${p.hands.endsWith('%') ? p.hands : '85%'}`}></i></span></span>
            <span class="prog__chev" aria-hidden="true">⌄</span>
          </summary>
          <div class="prog__body">
            <div class="prog__side">
              <dl class="prog__facts">
                <div><dt>מנחים</dt><dd>{p.hosts}</dd></div>
              </dl>
              <p class="prog__gets">{p.gets}</p>
            </div>
            <div class="prog__agenda">
              <p class="prog__agendaLabel">במה נוגעים</p>
              <ul class="topics">
                {p.topics.map((t) => <li>{t}</li>)}
              </ul>
              <p class="prog__adapt">את הסדר ואת הדגשים קובעים איתכם בשיחה, לפי מה שהצוות שלכם צריך.</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <Testimonials />

  <ContactWays />

  <SignupBand />
</Base>

<style>
  .sr { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
  .head { padding-block: 3rem 2.25rem; }
  .head__title { font-size: clamp(2.3rem, 5vw, 3.2rem); margin-block-end: 0.9rem; }
  .head__sub { font-size: var(--t-xl); color: var(--ink-muted); font-weight: 300; max-inline-size: 58ch; margin-block-end: 1.75rem; }
  .head__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .head__pair p { color: var(--ink-muted); font-weight: 300; font-size: var(--t-sm); margin: 0; }
  .head__pair strong { color: var(--ink-strong); font-weight: 700; }
  @media (max-width: 780px) { .head__pair { grid-template-columns: 1fr; gap: 1rem; } }

  .list { padding-block-end: 2.5rem; }
  .plist { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r-card); overflow: hidden; }
  .prog { border-block-end: 1px solid var(--rule); scroll-margin-block-start: 5rem; }
  .prog:last-child { border-block-end: none; }
  .prog__row {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.1fr auto; gap: 1.25rem; align-items: center;
    padding: 1.1rem 1.35rem; font-size: var(--t-sm); color: var(--ink-muted);
    transition: background var(--dur-fast) ease;
  }
  .prog__row::-webkit-details-marker { display: none; }
  .prog__row:hover { background: var(--surface-sunk); }
  .prog[open] .prog__row { background: var(--surface-sunk); }
  .prog__name { font-family: var(--font-display); font-size: var(--t-lg); color: var(--ink-strong); }
  .prog__k { display: none; }
  .prog__hands { font-weight: 700; color: var(--ink-strong); }
  .meter { display: block; block-size: 5px; border-radius: 3px; background: var(--rule); overflow: hidden; margin-block-start: 0.4rem; inline-size: 100%; }
  .meter i { display: block; block-size: 100%; inline-size: var(--w); background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform 0.9s var(--ease-out) 0.15s; }
  .prog[open] .meter i, .prog__row:hover .meter i { transform: scaleX(1); }
  .prog__chev {
    inline-size: 1.7rem; block-size: 1.7rem; border-radius: 50%; border: 1px solid var(--rule-strong);
    display: grid; place-items: center; color: var(--ink-muted); line-height: 1; padding-block-end: 0.2rem;
    transition: transform var(--dur-base) var(--ease-out), background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .prog[open] .prog__chev { transform: rotate(180deg); background: var(--accent-soft); border-color: var(--accent); }
  .prog__body { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 3rem; padding: 1.25rem 1.35rem 1.75rem; }
  .prog[open] .prog__body { animation: progOpen var(--dur-base) var(--ease-out); }
  @keyframes progOpen { from { opacity: 0; transform: translateY(-8px); } }
  .prog__facts { margin: 0 0 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .prog__facts > div { display: grid; grid-template-columns: 7rem 1fr; gap: 0.75rem; font-size: var(--t-sm); }
  .prog__facts dt { color: var(--ink-faint); }
  .prog__facts dd { margin: 0; color: var(--ink); }
  .prog__gets { color: var(--ink-muted); font-weight: 300; font-size: var(--t-sm); margin: 0; }
  .prog__agendaLabel { font-size: var(--t-xs); color: var(--ink-faint); margin-block-end: 0.6rem; }
  .topics { list-style: none; margin: 0; padding: 0; }
  .topics li { position: relative; padding-block: 0.65rem; padding-inline-start: 1.2rem; border-block-end: 1px solid var(--rule); font-size: var(--t-sm); color: var(--ink); }
  .topics li:last-child { border-block-end: none; }
  .topics li::before { content: ""; position: absolute; inset-inline-start: 0; inset-block-start: 1.2rem; inline-size: 0.45rem; block-size: 0.45rem; border-radius: 50%; background: var(--accent); }
  .prog__adapt { margin: 0.8rem 0 0; font-size: var(--t-xs); color: var(--ink-faint); }
  @media (max-width: 820px) {
    .prog__row { grid-template-columns: 1fr auto; row-gap: 0.5rem; }
    .prog__name { grid-column: 1; }
    .prog__chev { grid-column: 2; grid-row: 1; }
    .prog__cell { grid-column: 1 / -1; }
    .prog__k { display: inline; color: var(--ink-faint); margin-inline-end: 0.5rem; font-size: var(--t-xs); }
    .prog__body { grid-template-columns: 1fr; gap: 1.5rem; }
  }

</style>
