---
/**
 * מפת המדריך: 15 השיעורים של כלי אחד, בעמוד הכלי.
 * שיעור שנכתב ניתן ללחיצה; שיעור שעוד לא נכתב מופיע כ"בקרוב" —
 * כדי שההיקף ייראה מהיום הראשון. זה בדיוק מה שעבד במפת המסלול.
 *
 * כלי שאין לו מדריך (פרפלקסיטי, גאמה, התמלול) לא מייצר כאן כלום,
 * לא כותרת ולא רווח.
 */
import { getCollection } from 'astro:content';
import { madrichBySlug } from '../data/madrichim';

interface Props { guide: string; }
const { guide } = Astro.props;
const m = madrichBySlug(guide);

const written = m
  ? new Set(
      (await getCollection('madrich', (e) => e.data.published && e.data.guide === guide))
        .map((e) => e.id.split('/').pop()!),
    )
  : new Set<string>();
const done = m ? m.items.filter((i) => written.has(i.slug)).length : 0;
---
{m && (
  <section class="wrap mm reveal" aria-labelledby="mm-h">
    <div class="mm__head">
      <h2 id="mm-h" class="mm__title">{m.title}</h2>
      <p class="mm__spine">{m.spine}. {m.who}</p>
      <p class="mm__count">
        <strong data-tally={done}>{done}</strong> מתוך {m.items.length} שיעורים כתובים.
        השאר במפה כדי שתדעו לאן זה הולך.
      </p>
    </div>
    <ol class="mm__list" data-stagger="45">
      {m.items.map((it) => {
        const on = written.has(it.slug);
        const inner = (
          <>
            <span class="mm__n">{it.n}</span>
            <span class="mm__text">
              <span class="mm__t">{it.title}</span>
              <span class="mm__note">{it.note}</span>
            </span>
            <span class="mm__flags">
              {it.interactive && <span class="mm__int">אינטראקטיבי</span>}
              {!on && <span class="mm__soon">בקרוב</span>}
            </span>
          </>
        );
        return (
          <li class={on ? 'mm__item' : 'mm__item mm__item--soon'}>
            {on ? <a href={`/kelim/${guide}/${it.slug}`} class="mm__row">{inner}</a> : <span class="mm__row">{inner}</span>}
          </li>
        );
      })}
    </ol>
  </section>
)}

<style>
  .mm { padding-block: 2.25rem 1rem; }
  .mm__head { margin-block-end: 1.1rem; }
  .mm__title { font-size: var(--t-2xl); margin-block: 0 0.4rem; }
  .mm__spine { color: var(--ink-muted); font-size: var(--t-base); margin-block-end: 0.5rem; max-inline-size: 62ch; }
  .mm__count { font-size: var(--t-sm); color: var(--ink-faint); max-inline-size: 62ch; }
  .mm__count strong { color: var(--accent-deep); font-weight: 700; }

  .mm__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; counter-reset: none; }
  .mm__row {
    display: grid; grid-template-columns: 2.5rem 1fr auto; align-items: start; gap: 0.9rem;
    padding: 0.85rem 1.1rem; border: 1px solid var(--rule); border-radius: var(--r-card);
    background: var(--surface); text-decoration: none; color: var(--ink);
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  a.mm__row:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-1); }
  .mm__item--soon .mm__row { background: transparent; border-style: dashed; }
  .mm__n { font-family: var(--font-display); font-size: var(--t-lg); color: var(--ink-faint); line-height: 1.4; }
  a.mm__row .mm__n { color: var(--accent-deep); }
  .mm__text { display: flex; flex-direction: column; gap: 0.15rem; }
  .mm__t { font-weight: 600; color: var(--ink-strong); line-height: 1.45; }
  .mm__item--soon .mm__t { color: var(--ink-muted); font-weight: 500; }
  .mm__note { font-size: var(--t-sm); color: var(--ink-muted); line-height: 1.5; }
  .mm__item--soon .mm__note { color: var(--ink-faint); }
  .mm__flags { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; }
  .mm__int, .mm__soon { font-size: var(--t-xs); white-space: nowrap; }
  .mm__int { color: var(--accent-deep); font-weight: 500; }
  .mm__soon { color: var(--ink-faint); border: 1px solid var(--rule); border-radius: 999px; padding: 0.1rem 0.55rem; }
  @media (max-width: 560px) {
    .mm__row { grid-template-columns: 2rem 1fr; }
    .mm__flags { grid-column: 2; flex-direction: row; align-items: center; justify-content: flex-start; }
  }
</style>
