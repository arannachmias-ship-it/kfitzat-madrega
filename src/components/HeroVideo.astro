---
/**
 * סרטון האווירה מהסדנה. מתנגן לבד, בשקט ובלולאה (דפדפנים חוסמים סרטון שמתחיל עם קול),
 * וכפתור אחד מפעיל את הקול ומתחיל מההתחלה. מי שביקש פחות תנועה מקבל תמונה וכפתורי נגן רגילים.
 */
---
<div class="hv" data-hv>
  <video class="hv__v" muted loop playsinline autoplay preload="metadata" poster="/video/hero-poster.jpg" width="1280" height="720"
    aria-label="סרטון קצר מסדנת AI: משתתפים יוצרים פוסטרים, שירים וסרטונים מהטלפון, צוחקים ומצטלמים יחד">
    <source src="/video/hero-480.mp4" type="video/mp4" media="(max-width: 720px)" />
    <source src="/video/hero-720.mp4" type="video/mp4" />
  </video>
  <button class="hv__snd" type="button" data-hv-snd aria-pressed="false" aria-label="להפעיל קול" title="להפעיל קול">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
      <path class="hv__on" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path class="hv__off" d="M16.5 9.5l5 5M21.5 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<style>
  .hv { position: relative; border-radius: var(--r-card); overflow: hidden; background: var(--deep); box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.65), 0 0 0 1px var(--hero-edge); aspect-ratio: 16 / 9; }
  .hv__v { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
  /* כפתור קטן בפינה העליונה: הכותרות של הסרטון יושבות למטה ובאמצע */
  .hv__snd {
    position: absolute; inset-block-start: 0.6rem; inset-inline-end: 0.6rem;
    display: grid; place-items: center; inline-size: 44px; block-size: 44px; padding: 0;
    border: 2px solid rgba(12, 40, 49, 0.85); border-radius: 50%; background: var(--accent); color: var(--deep);
    cursor: pointer; box-shadow: 0 4px 14px -4px rgba(0, 0, 0, 0.7); transition: transform var(--dur-fast) ease;
  }
  .hv__snd:hover { transform: scale(1.06); }
  .hv__snd:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .hv__snd[aria-pressed="true"] .hv__off, .hv__snd[aria-pressed="false"] .hv__on { display: none; }
  .hv__snd[aria-pressed="true"] { background: rgba(12, 40, 49, 0.85); color: #fff; border-color: rgba(255, 255, 255, 0.75); }
</style>

<script>
  function initHv() {
    document.querySelectorAll<HTMLElement>('[data-hv]').forEach((box) => {
      if (box.dataset.ready) return;
      box.dataset.ready = '1';
      const v = box.querySelector('video')!;
      const btn = box.querySelector<HTMLButtonElement>('[data-hv-snd]')!;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        v.removeAttribute('autoplay'); v.pause(); v.controls = true; v.loop = false; btn.hidden = true;
        return;
      }
      btn.addEventListener('click', () => {
        const on = v.muted;
        v.muted = !on;
        if (on) { v.currentTime = 0; v.play().catch(() => {}); }
        btn.setAttribute('aria-pressed', String(on));
        const t = on ? 'להשתיק' : 'להפעיל קול';
        btn.setAttribute('aria-label', t); btn.title = t;
      });
      // לא מנגנים כשהסרטון מחוץ למסך
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }, { threshold: 0.2 }).observe(v);
      }
    });
  }
  initHv();
  document.addEventListener('astro:page-load', initHv);
</script>
