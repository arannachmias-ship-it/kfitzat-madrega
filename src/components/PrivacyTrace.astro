---
/**
 * "מסלול ההודעה" — חמש תחנות אחרי הודעה אחת, בשני טורים: חשבון פרטי
 * מול חשבון ארגוני.
 *
 * הרכיב משותף לשלושת המדריכים. `tool` בוחר את מערך הנתונים, והטקסט
 * מגיע מ-claude/מה-אומת-על-שלושת-הכלים.md בלבד. טענה שאין לה שורה שם
 * לא נכנסת לכאן, וטענה שלא אומתה כתובה כאן ככזאת.
 *
 * למה שני טורים ולא רשימה: כל הדיון המסחרי על מושבים ארגוניים יושב
 * בפער בין הטורים. רשימה אחת מסתירה בדיוק את מה שצריך להיראות.
 */

type Station = { n: number; q: string; personal: string; org: string; sting?: string };
type TraceSet = { label: string; personalName: string; orgName: string; stations: Station[] };

const DATA: Record<string, TraceSet> = {
