interface Props { tool: 'chatgpt' | 'gemini' | 'claude' }
const { tool } = Astro.props;
const set = DATA[tool];
---
<div class="pt" data-pt>
  <p class="pt__label">מסלול ההודעה: חמש תחנות, שני חשבונות</p>

  <div class="pt__track" role="tablist">
    {set.stations.map((s, i) => (
      <button type="button" role="tab" data-pt-go={String(i)} aria-selected={i === 0 ? 'true' : 'false'}>
        <span class="pt__n">{s.n}</span>
        <span>{s.q}</span>
      </button>
    ))}
  </div>

  <div class="pt__panel" data-pt-panel></div>

  <script type="application/json" data-pt-data set:html={JSON.stringify(set)}></script>
</div>

<script is:inline data-astro-rerun>
  (function () {
    const root = document.querySelector('[data-pt]');
    if (!root || root.dataset.ptReady) return;
    root.dataset.ptReady = '1';

    const set = JSON.parse(root.querySelector('[data-pt-data]').textContent);
    const panel = root.querySelector('[data-pt-panel]');
    const tabs = Array.prototype.slice.call(root.querySelectorAll('[data-pt-go]'));

    function esc(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function show(i) {
      const s = set.stations[i];
      tabs.forEach(function (t) { t.setAttribute('aria-selected', String(Number(t.dataset.ptGo) === i)); });

      const sting = s.sting
        ? '<div class="pt__sting"><p><strong>השורה שמפתיעה:</strong> ' + esc(s.sting) + '</p></div>'
        : '';

      panel.innerHTML =
        '<h4 class="pt__q">' + esc(s.q) + '</h4>' +
        '<div class="pt__cols">' +
        '<div class="pt__col"><p class="pt__colname">' + esc(set.personalName) + '</p><p class="pt__body">' + esc(s.personal) + '</p></div>' +
        '<div class="pt__col pt__col--org"><p class="pt__colname">' + esc(set.orgName) + '</p><p class="pt__body">' + esc(s.org) + '</p></div>' +
        '</div>' + sting;
    }

    tabs.forEach(function (t) {
      t.addEventListener('click', function () { show(Number(t.dataset.ptGo)); });
    });

    show(0);
  })();
</script>

<style>
  .pt {
    background: var(--surface); border: 1px solid var(--rule);
    border-radius: var(--r-card); padding: 1.5rem 1.65rem; margin-block: 2rem;
  }
  .pt__label { font-size: var(--t-xs); color: var(--ink-faint); margin: 0 0 1rem; }

  .pt__track { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.4rem; }
  @media (max-width: 760px) { .pt__track { grid-template-columns: 1fr; } }
  .pt__track button {
    font: inherit; font-size: var(--t-xs); text-align: start; cursor: pointer;
    display: flex; align-items: baseline; gap: 0.45rem; line-height: 1.35;
    padding: 0.55rem 0.65rem; border-radius: var(--r-control);
    border: 1px solid var(--rule); background: transparent; color: var(--ink-muted);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .pt__track button:hover { border-color: var(--rule-strong); color: var(--ink-strong); }
  .pt__track button[aria-selected='true'] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 500; }
  .pt__n { font-family: var(--font-display); font-size: var(--t-sm); flex: none; opacity: 0.7; }

  .pt__panel { margin-block-start: 1.2rem; }
  .pt :global(.pt__q) { font-family: var(--font-display); font-size: var(--t-xl); color: var(--ink-strong); margin: 0 0 0.8rem; }
  .pt :global(.pt__cols) { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  @media (max-width: 680px) { .pt :global(.pt__cols) { grid-template-columns: 1fr; } }
  .pt :global(.pt__col) {
    background: var(--surface-sunk); border-radius: var(--r-card);
    padding: 0.9rem 1.05rem; border-inline-start: 3px solid var(--rule-strong);
  }
  .pt :global(.pt__col--org) { background: var(--deep); border-inline-start-color: var(--accent); }
  .pt :global(.pt__colname) { font-size: var(--t-xs); color: var(--ink-faint); margin: 0 0 0.35rem; }
  .pt :global(.pt__col--org .pt__colname) { color: var(--accent); }
  .pt :global(.pt__body) { font-size: var(--t-sm); line-height: 1.65; color: var(--ink-muted); margin: 0; }
  .pt :global(.pt__col--org .pt__body) { color: var(--ink-on-deep-mute); }
  .pt :global(.pt__sting) {
    margin-block-start: 0.9rem; padding: 0.85rem 1rem;
    border: 1px solid var(--rule); border-inline-start: 3px solid var(--state-warn);
    border-radius: var(--r-card);
  }
  .pt :global(.pt__sting p) { font-size: var(--t-sm); color: var(--ink); line-height: 1.65; margin: 0; max-inline-size: 74ch; }
  .pt :global(.pt__sting strong) { color: var(--ink-strong); }
</style>
