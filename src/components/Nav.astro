---
const links = [
  { href: '/maslul', label: 'המסלול' },
  { href: '/irgunim', label: 'לארגונים' },
  { href: '/anachnu', label: 'מי אנחנו' },
];
const path = Astro.url.pathname;
---
<header class="nav" id="site-nav">
  <div class="wrap nav__inner">
    <a href="/" class="nav__brand" transition:name="brand">קפיצת מדרגה</a>
    <nav aria-label="ניווט ראשי" class="nav__links">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="/#hearshmu" class="nav__cta">קבלו שיעור בשבוע</a>
    </nav>
  </div>
</header>

<script>
  // compact the bar after a little scroll; rAF-throttled, no layout reads in the handler
  function initNav() {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    let ticking = false;
    const update = () => { nav.classList.toggle('nav--compact', window.scrollY > 24); ticking = false; };
    update();
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  }
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(241, 244, 244, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
    border-block-end: 1px solid transparent;
    transition: border-color var(--dur-base) ease, box-shadow var(--dur-base) ease;
  }
  .nav--compact { border-block-end-color: var(--rule); box-shadow: 0 8px 24px -18px rgba(12, 40, 49, 0.35); }
  @supports not (backdrop-filter: blur(1px)) { .nav { background: rgba(241, 244, 244, 0.96); } }
  @media (prefers-reduced-transparency: reduce) { .nav { background: var(--paper); backdrop-filter: none; -webkit-backdrop-filter: none; } }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-block-size: 68px;
    padding-block: 0.75rem;
    transition: min-block-size var(--dur-base) var(--ease-out), padding var(--dur-base) var(--ease-out);
  }
  .nav--compact .nav__inner { min-block-size: 56px; padding-block: 0.4rem; }
  .nav__brand {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--ink-strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: var(--t-sm);
  }
  .nav__links a { color: var(--ink-muted); text-decoration: none; white-space: nowrap; position: relative; transition: color var(--dur-fast) ease; }
  .nav__links a:not(.nav__cta)::after { content: ""; position: absolute; inset-inline: 0; bottom: -4px; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform var(--dur-base) var(--ease-out); }
  .nav__links a:not(.nav__cta):hover::after, .nav__links a[aria-current='page']::after { transform: scaleX(1); }
  .nav__links a:hover { color: var(--ink-strong); }
  .nav__links a[aria-current='page'] { color: var(--ink-strong); font-weight: 500; }
  .nav__cta {
    background: var(--deep);
    color: var(--ink-on-deep) !important;
    padding: 0.55rem 1.25rem;
    border-radius: var(--r-control);
    font-weight: 500;
  }
  .nav__cta { transition: background var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out); }
  .nav__cta:hover { background: var(--deep-2); color: var(--ink-on-deep) !important; }
  .nav__cta:active { transform: scale(0.97); }

  @media (max-width: 780px) {
    .nav__inner { flex-wrap: wrap; min-block-size: 0; }
    .nav__links { gap: 1rem; font-size: var(--t-xs); flex-wrap: wrap; }
  }
</style>
