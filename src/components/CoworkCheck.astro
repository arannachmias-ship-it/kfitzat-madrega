---
/**
 * "מה יש לכם בפועל" — שיעור 12 במדריך קלוד.
 *
 * הרכיב קיים בשביל שורה אחת שאף אחד לא מאמין לה עד שהוא רואה אותה:
 * בשתי יכולות, חשבון ארגוני מקבל פחות מחשבון פרטי בתשלום. שליטה
 * במחשב היא ביתא ב-Pro וב-Max בלבד, והקלטת סקיל אינה בארגוני.
 *
 * מי שקונה מושבים ומבטיח לצוות שליטה במחשב — מבטיח משהו שאין.
 */

type Cap = { id: string; name: string; note: string; plans: Record<string, string> };

const PLANS = [
  { id: 'free', name: 'חינם' },
  { id: 'pro', name: 'Pro' },
  { id: 'max', name: 'Max' },
  { id: 'team', name: 'צוות' },
  { id: 'org', name: 'ארגוני' },
];

const CAPS: Cap[] = [
  {
    id: 'cowork',
    name: 'Cowork',
    note: 'הצורה שהכי רחוקה משיחה: נותנים משימה והולכים. שולחן עבודה במאק ובווינדוס; רשת ונייד בגרסת ביתא.',
    plans: { free: 'no', pro: 'yes', max: 'yes', team: 'yes', org: 'yes' },
  },
  {
    id: 'tasks',
    name: 'משימות מתוזמנות',
    note: 'רצות מרחוק גם כשהמחשב שלכם ישן. המרווח המינימלי בין הרצות הוא שעה. יושבות בתוך Cowork, ולכן מי שאין לו Cowork אין לו גם אותן.',
    plans: { free: 'no', pro: 'yes', max: 'yes', team: 'yes', org: 'yes' },
  },
  {
    id: 'computer',
    name: 'שליטה במחשב',
    note: 'בגרסת ביתא, באפליקציית שולחן העבודה, במאק ובווינדוס.',
    plans: { free: 'no', pro: 'beta', max: 'beta', team: 'no', org: 'no' },
  },
  {
    id: 'record',
    name: 'הקלטת סקיל',
    note: 'להקליט את עצמכם עושים משימה, ולקבל ממנה סקיל. במאק בלבד, ודרך Cowork.',
    plans: { free: 'no', pro: 'yes', max: 'yes', team: 'yes', org: 'no' },
  },
  {
    id: 'orgskills',
    name: 'סקילים לכל הארגון',
    note: 'להפיץ סקיל לכל מי שיש לו מושב. הבעלים בלבד מפיץ.',
    plans: { free: 'no', pro: 'no', max: 'no', team: 'yes', org: 'yes' },
  },
];
---
<div class="cw" data-cw>
  <p class="cw__label">בחרו תוכנית, ותראו מה באמת יש בה</p>

  <div class="cw__plans">
    {PLANS.map((p, i) => (
      <button type="button" data-cw-plan={p.id} aria-pressed={i === 1 ? 'true' : 'false'}>{p.name}</button>
    ))}
  </div>

  <div class="cw__out" data-cw-out></div>

  <script type="application/json" data-cw-caps set:html={JSON.stringify(CAPS)}></script>
  <script type="application/json" data-cw-plans set:html={JSON.stringify(PLANS)}></script>
</div>

<script is:inline data-astro-rerun>
  (function () {
    const root = document.querySelector('[data-cw]');
    if (!root || root.dataset.cwReady) return;
    root.dataset.cwReady = '1';

    const caps = JSON.parse(root.querySelector('[data-cw-caps]').textContent);
    const plans = JSON.parse(root.querySelector('[data-cw-plans]').textContent);
    const out = root.querySelector('[data-cw-out]');
    const btns = Array.prototype.slice.call(root.querySelectorAll('[data-cw-plan]'));

    const MARK = { yes: 'יש', beta: 'ביתא', no: 'אין' };

    function show(id) {
      const plan = plans.filter(function (p) { return p.id === id; })[0];
      btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.cwPlan === id)); });

      let rows = '';
      let have = 0;
      caps.forEach(function (c) {
        const st = c.plans[id];
        if (st !== 'no') have++;
        rows +=
          '<div class="cw__row cw__row--' + st + '">' +
          '<p class="cw__rowhead"><span class="cw__mark">' + MARK[st] + '</span> ' + c.name + '</p>' +
          '<p class="cw__note">' + c.note + '</p>' +
          '</div>';
      });

      // השורה שכל הרכיב קיים בשבילה
      let punch = '';
      if (id === 'team' || id === 'org') {
        punch =
          '<p class="cw__punch"><strong>שימו לב למה שאין כאן:</strong> ' +
          '<strong>שליטה במחשב אינה זמינה בצוות ובארגוני בכלל</strong> — היא ביתא ב־Pro וב־Max בלבד' +
          (id === 'org' ? ', והקלטת סקיל אינה זמינה בארגוני' : '') +
          '. כלומר בשתי יכולות, החשבון שמשלמים עליו מקבל פחות מחשבון פרטי בתשלום. ' +
          'זה נשמע כמו טעות והוא לא: יכולת בביתא נפתחת קודם למי שיכול להסכים לה לבד, ולא לארגון שצריך להסכים בשם מאתיים איש.</p>';
      } else if (id === 'pro' || id === 'max') {
        punch =
          '<p class="cw__punch"><strong>מה שאין כאן, ושווה לדעת:</strong> ' +
          'אי אפשר להפיץ סקיל לכל הארגון מחשבון פרטי. ההפצה שייכת לצוות ולארגוני, ולבעלים בלבד. ' +
          'כלומר סקיל שבניתם כאן הוא שלכם, ואינו נכס של הצוות עד שמישהו קונה מושבים.</p>';
      } else {
        punch =
          '<p class="cw__punch"><strong>מה שצריך לדעת על החינמי:</strong> ' +
          'כל מה שברשימה הזאת שייך לתוכניות בתשלום. החינמי מצוין לשיחה, והוא לא הכלי שמריץ משימות. ' +
          'אם זה מה שאתם מחפשים, השאלה אינה איך להגדיר אלא איזו תוכנית.</p>';
      }

      out.innerHTML =
        '<p class="cw__verdict" data-tally="' + have + '">' + have + ' מתוך ' + caps.length + ' זמינות ב' + plan.name + '.</p>' +
        rows + punch;
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () { show(b.dataset.cwPlan); });
    });

    show('pro');
  })();
</script>

<style>
  .cw {
    background: var(--surface); border: 1px solid var(--rule);
    border-radius: var(--r-card); padding: 1.5rem 1.65rem; margin-block: 2rem;
  }
  .cw__label { font-size: var(--t-xs); color: var(--ink-faint); margin: 0 0 1rem; }

  .cw__plans { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cw__plans button {
    font: inherit; font-size: var(--t-sm); cursor: pointer;
    padding: 0.4rem 0.95rem; border-radius: var(--r-control);
    border: 1px solid var(--rule); background: transparent; color: var(--ink-muted);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .cw__plans button:hover { border-color: var(--rule-strong); color: var(--ink-strong); }
  .cw__plans button[aria-pressed='true'] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 500; }

  .cw__out { margin-block-start: 1.2rem; }
  .cw :global(.cw__verdict) { font-family: var(--font-display); font-size: var(--t-lg); color: var(--ink-strong); margin: 0 0 0.8rem; }
  .cw :global(.cw__row) {
    background: var(--surface-sunk); border-radius: var(--r-card);
    padding: 0.75rem 0.95rem; margin-block-end: 0.5rem;
    border-inline-start: 3px solid var(--state-bad);
  }
  .cw :global(.cw__row--yes) { border-inline-start-color: var(--state-ok); }
  .cw :global(.cw__row--beta) { border-inline-start-color: var(--state-warn); }
  .cw :global(.cw__rowhead) { font-size: var(--t-sm); color: var(--ink-strong); margin: 0 0 0.2rem; font-weight: 600; }
  .cw :global(.cw__mark) {
    display: inline-block; font-size: var(--t-xs); font-weight: 400;
    padding: 0.05rem 0.45rem; border-radius: var(--r-control);
    background: var(--state-bad); color: var(--paper);
  }
  .cw :global(.cw__row--yes .cw__mark) { background: var(--state-ok); }
  .cw :global(.cw__row--beta .cw__mark) { background: var(--state-warn); }
  .cw :global(.cw__note) { font-size: var(--t-sm); color: var(--ink-muted); line-height: 1.6; margin: 0; max-inline-size: 72ch; }
  .cw :global(.cw__row--no .cw__note) { color: var(--ink-faint); }
  .cw :global(.cw__punch) {
    margin-block-start: 0.9rem; background: var(--deep); border-radius: var(--r-card);
    padding: 1.05rem 1.25rem; border-inline-start: 3px solid var(--accent);
    font-size: var(--t-sm); line-height: 1.65; color: var(--ink-on-deep-mute); max-inline-size: 72ch;
  }
  .cw :global(.cw__punch strong) { color: var(--accent); }
</style>
